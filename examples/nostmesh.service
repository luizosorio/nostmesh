[Unit]
Description=NostMesh overlay network node
Documentation=https://github.com/luizosorio/nostmesh
After=network-online.target
Wants=network-online.target

# The data plane is the kernel's WireGuard. This service configures it over
# netlink and never loads it, so the module has to be present already:
#   echo wireguard > /etc/modules-load.d/wireguard.conf
After=modprobe@wireguard.service
Wants=modprobe@wireguard.service

[Service]
Type=simple
ExecStart=/usr/local/bin/nostmesh serve --config /etc/nostmesh/nostmesh.json

# SIGHUP reloads the allowlist: a peer can be authorized or revoked without
# dropping the tunnels that are working. Node settings — listen port, relays,
# state directory — are not reloadable, and the service says so rather than
# appearing to apply them.
ExecReload=/bin/kill -HUP $MAINPID

# Restart on failure, not on a clean stop: `systemctl stop` is an instruction,
# not a fault to recover from.
Restart=on-failure
RestartSec=5s

# Configuring WireGuard and network state needs CAP_NET_ADMIN, and nothing more.
# Running as root would grant the rest for no reason.
User=nostmesh
Group=nostmesh
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# The private key lives here, and so does the control socket. 0700 keeps both
# from anyone but this service.
StateDirectory=nostmesh
StateDirectoryMode=0700
ConfigurationDirectory=nostmesh

# The private key is the node's identity: a process that cannot dump core cannot
# have it read out of one.
LimitCORE=0

# Anything this service creates is private to it. The control socket sets its own
# mode explicitly and verifies it afterwards, because a umask can only take
# permissions away — but the keystore and the journal are covered by this, and a
# default that leaves them world-readable is not one to inherit.
UMask=0077

# Filesystem: nothing outside its own directories is writable, and the rest of
# the system is invisible where it can be.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes

# The binary never loads a module: the wireguard module is the operator's
# prerequisite, loaded before the service starts.
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The node speaks UDP to peers, WebSocket to relays, and netlink to the kernel.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# Structured logs go to stderr, which the journal captures.
#   journalctl -u nostmesh -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
